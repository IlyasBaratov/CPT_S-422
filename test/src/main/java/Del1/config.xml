<?xml version="1.0"?>

<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

    <module name="TreeWalker">

        <!-- Deliverable 1: Count comments -->
        <module name="Del1.CommentCountCheck">
        <property name="severity" value="info" />
	</module>

        <!-- Deliverable 1: Count loops -->
        <module name="Del1.LoopCountCheck">
        <property name="severity" value="info" />
	</module>

        <!-- Quiz 2: Detect Hungarian notation -->
        <module name="Quiz2.AntiHungarianCheck">
        <property name="severity" value="info" />
	</module>

    </module>

</module>